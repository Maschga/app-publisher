{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EVCC_APP_CUSTOM_NAME": "EnergyHub21",
        "EVCC_APP_CUSTOM_EXPO_SLUG": "energyhub21",
        "EVCC_APP_CUSTOM_EXPO_OWNER": "sun21-smart-energy-gmbh",
        "EVCC_APP_CUSTOM_EAS_PROJECT_ID": "7881f761-7aae-414d-a2fa-0e55b41e391a",
        "EVCC_APP_CUSTOM_FONT_BOLD": "../custom-assets/fonts/Roboto-Bold.ttf",
        "EVCC_APP_CUSTOM_FONT_MEDIUM": "../custom-assets/fonts/Roboto-Medium.ttf",
        "EVCC_APP_CUSTOM_LOGO_LIGHT": "../custom-assets/icon-light.png",
        "EVCC_APP_CUSTOM_IOS_BUNDLE_IDENTIFIER": "io.energyhub21.ios",
        "EVCC_APP_CUSTOM_IOS_APPLE_TEAM_ID": "TOBEADDED",
        "EVCC_APP_CUSTOM_ANDROID_PACKAGE": "io.energyhub21.android",
        "EVCC_APP_CUSTOM_ANDROID_ADAPTIVE_ICON": "../custom-assets/adaptive-icon.png",
        "EVCC_APP_CUSTOM_ANDROID_ADAPTIVE_ICON_BACKGROUND_COLOR": "#ffffff",
        "EVCC_APP_CUSTOM_WEB_FAVICON": "../custom-assets/favicon.png",
        "EVCC_APP_CUSTOM_SPLASH_IMAGE_LIGHT": "../custom-assets/splash-icon-dark.png",
        "EVCC_APP_CUSTOM_SPLASH_BACKGROUND_COLOR_LIGHT": "#ffffff",
        "EVCC_APP_CUSTOM_SPLASH_IMAGE_DARK": "../custom-assets/splash-icon-light.png",
        "EVCC_APP_CUSTOM_SPLASH_BACKGROUND_COLOR_DARK": "#171917",
        "EVCC_APP_CUSTOM_ONBOARDING_ICON": "../custom-assets/icon-trans-light.svg",
        "EVCC_APP_CUSTOM_THEME_PRIMARY_LIGHT": "#7aae00",
        "EVCC_APP_CUSTOM_THEME_PRIMARY_DARK": "#97d700",
        "EXPO_NO_DOTENV": "1"
      }
    }
  }
}
